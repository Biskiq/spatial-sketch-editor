{
  "name": "@biskiq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages ../../node_modules/vite-node/vite-node.mjs src/start.ts",
    "build": "tsc -p tsconfig.json",
    "start": "vite-node dist/start.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate": "npm run build && node dist/migrate.js",
    "purge:objects": "npm run build && node dist/purge-objects.js",
    "cleanup:project-deletions": "npm run build && node dist/cleanup-project-deletions.js",
    "test": "npm run build && vite-node tests/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@fastify/secure-session": "^8.3.0",
    "@portfolio/layout-core": "*",
    "@portfolio/project-model": "*",
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@portfolio/tsconfig": "*",
    "@types/node": "^20.5.6",
    "@types/pg": "^8.10.0",
    "typescript": "^5.8.0",
    "vite-node": "^3.2.4"
  }
}
