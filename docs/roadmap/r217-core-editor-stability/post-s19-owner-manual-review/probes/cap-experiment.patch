diff --git a/apps/editor/src/lib/layout/wall-mesh-builder.ts b/apps/editor/src/lib/layout/wall-mesh-builder.ts
index f61779c6..c287d3a7 100644
--- a/apps/editor/src/lib/layout/wall-mesh-builder.ts
+++ b/apps/editor/src/lib/layout/wall-mesh-builder.ts
@@ -434,6 +434,25 @@ export function buildStandaloneWallMesh(
 		const ref: WallMeshSectionRef = { roomId: wall.wallId, segmentId: wall.wallId, sectionIndex: -1, kind: 'side' };
 		faces.sections.push({ ref, surfaceKey: classify(ref), faces: keelFaces });
 	}
+	// PR #247 EXPERIMENT ONLY: close a free end. Bands split at the same breakpoints as the
+	// side faces so the vertical edges weld.
+	for (const [join, atEnd] of [[ends?.start ?? null, false], [ends?.end ?? null, true]] as const) {
+		if (join !== null && join.kind !== 'terminal') continue;
+		const sample = atEnd ? last : first;
+		const corner = squareEndCorner(sample.point, sample.normal, half);
+		const dir: LayoutVec2 = atEnd ? sample.tangent : [-sample.tangent[0], -sample.tangent[1]];
+		const capFaces: Face[] = [];
+		for (const [lo, hi] of endpointProfileIntervals(wallAsCompiled, atEnd)) {
+			const bands = segmentBands(lo, lo, hi, breakpoints);
+			for (let k = 1; k < bands.length; k += 1) {
+				pushBridgeCap(capFaces, (corner.front as { apex: LayoutVec2 }).apex, (corner.back as { apex: LayoutVec2 }).apex, floorElevation + bands[k - 1]!, floorElevation + bands[k]!, bands[k - 1]!, bands[k]!, dir, 1);
+			}
+		}
+		if (capFaces.length > 0) {
+			const ref: WallMeshSectionRef = { roomId: wall.wallId, segmentId: wall.wallId, sectionIndex: -1, kind: 'side' };
+			faces.sections.push({ ref, surfaceKey: classify(ref), faces: capFaces });
+		}
+	}
 	const wallsFaces = [faces];
 	const mesh = emitMesh(wall.wallId, wallsFaces, classify, weldTolerance);
 	if (options.assertWinding) assertWindingAgreesWithNormals(mesh);
