[TEMPLATE]
# Copy to .env and adjust for local development (never commit .env). The
# workspace commands read process.env; export these values before running API
# commands, for example: `set -a; source .env; set +a`.
#
# `npm run dev:local` is the self-contained path and does NOT read this file: it
# supplies its own loopback database, storage and session values from
# `.local/dev-stack.json`. Use this file for the legacy `stack:up` / host-Postgres
# flows and for deployed configuration.
#
# Deployed equivalents: PUBLIC_API_ORIGIN goes in the Vercel project env;
# SESSION_KEY / DATABASE_URL / PORT / EDITOR_ORIGIN / API_ORIGIN / R2_* are set
# as env vars on the Render service only. SESSION_KEY is private — never expose
# it through public SvelteKit (PUBLIC_*) environment variables.
#
# Production must use sibling custom domains under one registrable domain (for
# example https://editor.example.com and https://api.example.com). The default
# Vercel/Render hostnames are cross-site and are for development smoke only.

# --- @biskiq/api (apps/api) — read from process.env via readConfig ---

# Required for the API. Use a local Postgres or dedicated Neon development
# database here — never copy the production DATABASE_URL into local .env.
# `npm run migrate:api` changes whichever database this value targets.
# `npm run stack:up` (docker-compose.yml) ignores this value: its API and
# migrations always use the Compose database.
DATABASE_URL=postgres://user:password@localhost:5432/biskiq

# Required. Port the API listens on (Render injects PORT on deploy).
PORT=8787

# Required. 32-byte key for
# @fastify/secure-session; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_KEY=base64-32-byte-session-key

# Required. Allowed editor origin for credentialed cross-origin CORS and the
# post-login redirect. No wildcard is permitted.
EDITOR_ORIGIN=http://localhost:5173
# Hosted staging example (use the stable Vercel production origin, not a
# changing preview URL): https://your-editor.vercel.app

# Optional in deployment: pin the public API base URL. It may include the
# Vercel proxy path and may be omitted only for local host-derived development.
API_ORIGIN=http://localhost:8787
# Hosted staging example: https://your-editor.vercel.app/api

# Required for P20 project asset bytes. The endpoint is the private
# Cloudflare R2 S3-compatible endpoint; credentials never enter the editor.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=biskiq-assets-store
# Deployment-owned object key namespace, unique per environment. Every asset
# key starts with projects/<namespace>/; the epoch purge refuses a bucket that
# also holds another namespace's keys. 1-32 lowercase letters, digits or hyphens.
R2_OBJECT_NAMESPACE=local
R2_ACCESS_KEY_ID=r2-access-key
R2_SECRET_ACCESS_KEY=r2-secret-key

# Development-only local object storage. Leave unset for Cloudflare R2 (the
# default and the only production path). `npm run dev:local` sets this to 1
# together with a loopback HTTP R2_ENDPOINT for its SeaweedFS service. When set,
# the API requires R2_ENDPOINT to be a credential-free loopback HTTP URL and
# refuses to start with NODE_ENV=production; R2 validation is not relaxed. Never
# set it on a deployed service.
# LOCAL_OBJECT_STORE=1

# Optional. Bearer secret enabling the test-only authentication seam
# (`POST {API origin}/test-auth/session`) for automated agent/browser tests.
# Absent by default — the route does not exist without it (fail closed).
# Set this ONLY on local/CI API instances. NEVER set it on production:
# anyone holding it can mint sessions for the allowlisted automation
# identities (`agent-admin`, `agent-user-a`, `agent-user-b`). The seam issues
# the same canonical session local login creates; ownership and permission checks
# still apply. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# E2E_TEST_AUTH_SECRET=base64-32-byte-test-auth-secret

# --- @portfolio/editor (apps/editor) — read at runtime via $env/dynamic/public ---

# Optional. Base URL of the deployed @biskiq/api. Leave unset to keep the
# cloud Save/Load UI disabled (P19 behavior).
PUBLIC_API_ORIGIN=http://localhost:8787
# Hosted staging value: https://your-editor.vercel.app/api
