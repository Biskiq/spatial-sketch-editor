{
  "name": "personal-portfolios",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "set -a; . .env; set +a; npm run dev:editor",
    "dev:editor": "npm run dev -w @portfolio/editor",
    "dev:local": "node tools/local-dev/dev-local.mjs start",
    "dev:local:stop": "node tools/local-dev/dev-local.mjs stop",
    "dev:local:reset": "node tools/local-dev/dev-local.mjs reset",
    "dev:local:logs": "node tools/local-dev/dev-local.mjs logs",
    "dev:local:status": "node tools/local-dev/dev-local.mjs status",
    "dev:api": "npm run dev -w @biskiq/api",
    "api": "set -a; . .env; set +a; npm run dev:api",
    "build": "npm run build:editor",
    "build:api": "npm run build -w @biskiq/api",
    "migrate:api": "set -a; . .env; set +a; npm run migrate -w @biskiq/api",
    "stack:up": "test -f .env || { echo 'stack:up needs .env (cp .env.example .env, then set the Google, SESSION_KEY and R2 values)' >&2; exit 1; }; docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f api migrate db",
    "stack:migrate": "docker compose run --rm --build migrate",
    "stack:reset": "docker compose down --volumes",
    "test:api:stack": "set -a; . .env; set +a; DATABASE_URL=postgresql://biskiq:biskiq@localhost:${BISKIQ_DB_PORT:-5433}/biskiq npm run test:api",
    "build:editor": "npm run build -w @portfolio/editor",
    "check": "npm run check -w @portfolio/editor",
    "check:api": "npm run check -w @biskiq/api",
    "check:camera-core": "npm run check -w @portfolio/camera-core",
    "check:layout-core": "npm run check -w @portfolio/layout-core",
    "check:geometry-core": "npm run check -w @portfolio/geometry-core",
    "check:project-model": "npm run check -w @portfolio/project-model",
    "test": "npm run test -w @portfolio/editor",
    "test:fast": "npm run test:fast -w @portfolio/editor",
    "test:arch": "npm run test:arch -w @portfolio/editor",
    "test:heavy": "npm run test:heavy -w @portfolio/editor",
    "test:full": "npm run test:full -w @portfolio/editor",
    "test:api": "npm run test -w @biskiq/api",
    "test:local-dev": "node --test tools/local-dev/stack.test.mjs",
    "status": "node tools/harness/status.mjs",
    "gate:produce": "node tools/harness/produce.mjs",
    "gate:aggregate": "node tools/harness/aggregate.mjs",
    "gate:guards": "node tools/harness/guards.mjs",
    "perf": "npm run perf -w @portfolio/editor",
    "perf:spot": "npm run perf:spot -w @portfolio/editor",
    "perf:bundle": "npm run perf:bundle -w @portfolio/editor"
  },
  "engines": {
    "node": ">=20"
  }
}
