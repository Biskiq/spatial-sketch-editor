{
  "name": "native-form-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5193 --strictPort",
    "build": "npm run typecheck && vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --maxWorkers=2 --minWorkers=1",
    "qa:browser": "node qa/browser-check.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4193 --strictPort"
  },
  "dependencies": {
    "@threlte/core": "^8.0.4",
    "svelte": "5.57.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/three": "^0.186.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7"
  }
}
