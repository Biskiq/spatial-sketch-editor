{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "c2-objects-and-assemblies",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8832",
        "--directory",
        "prototypes/object-composition-prototype"
      ],
      "port": 8832
    },
    {
      "name": "vellum",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "prototypes/p3-vellum",
        "run",
        "dev"
      ],
      "port": 5191
    },
    {
      "name": "shell-wireframe",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "prototypes/production-shell-wireframe/serve.py",
        "8850"
      ],
      "port": 8850
    },
    {
      "name": "editor",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:editor"
      ],
      "port": 5173
    },
    {
      "name": "design-system",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8861",
        "--directory",
        "docs/design-system"
      ],
      "port": 8861
    },
    {
      "name": "world-creation-tools",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8840",
        "--directory",
        "prototypes/world-creation-tools"
      ],
      "port": 8840
    },
    {
      "name": "appearance-ux",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "prototypes/appearance-ux/serve.py",
        "8870"
      ],
      "port": 8870,
      "url": "http://127.0.0.1:8870"
    }
  ]
